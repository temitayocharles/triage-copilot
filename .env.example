# Firebase web app config (Firebase console > Project settings > Your apps).
# These values are public by design for a web app, but keep real values in
# .env (git-ignored), not in this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA ENTERPRISE site key for App Check on the deployed app.
# (Firebase console > Security > App Check. Public site key, not the secret.
# Classic v3 registration is deprecated; use Enterprise.)
VITE_RECAPTCHA_SITE_KEY=

# Optional: App Check debug token for local development.
# Register it in Firebase console > Security > App Check > Manage debug tokens.
# When set, the SDK exchanges this token instead of running attestation.
VITE_APPCHECK_DEBUG_TOKEN=
